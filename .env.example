# Bitget普通交易 API (用于真实交易，可选)
BITGET_API_KEY=
BITGET_SECRET_KEY=
BITGET_PASSPHRASE=

# Bitget Playbook 专用 (自然语言策略调用)
PLAYBOOK_API_KEY=

# Bitget Agent Hub Skill endpoint (可选自定义)
AGENT_HUB_BASE_URL=https://api.bitget.com
SKILL_HUB_BASE_URL=https://skill-hub.bitget.com

# Bitget 子账户 (用于模拟交易隔离)
BITGET_SUBACCOUNT_ID=

# 可选: 用于服务端 LLM 调用
OPENAI_API_KEY=
